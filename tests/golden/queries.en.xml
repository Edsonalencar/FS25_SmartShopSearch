    <case id="en-baler" req="RF-025" query="baler"><expectTop n="5" minHits="2" category="BALERS*" /></case>
    <case id="en-sprayer" req="RF-025" query="sprayer"><expectTop n="5" minHits="3" category="SPRAYERS*" /></case>
